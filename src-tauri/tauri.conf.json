{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yawnoc",
  "version": "0.1.0",
  "identifier": "dev.carlk.yawnoc",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yawnoc",
        "width": 1040,
        "height": 860,
        "minWidth": 760,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
